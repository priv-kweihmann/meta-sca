From cd142ac6c1d218f04618789647e0b3560b7f6133 Mon Sep 17 00:00:00 2001
From: Konrad Weihmann <kweihmann@outlook.com>
Date: Fri, 20 Nov 2026 11:19:02 +0100
Subject: [PATCH] licensedcode: remove pluggy interfaces

as suggested by NixOS to move forward
with latest pluggy releases.
Should be remove once scancode-toolkit finally
releases anything new

Upstream-Status: Inappropriate [disable feature]
Signed-off-by: Konrad Weihmann <kweihmann@outlook.com>
---
 src/licensedcode/additional_license_location_provider.py | 1 -
 1 file changed, 1 deletion(-)

diff --git a/src/licensedcode/additional_license_location_provider.py b/src/licensedcode/additional_license_location_provider.py
index 778958cbdd..14a28f34cb 100644
--- a/src/licensedcode/additional_license_location_provider.py
+++ b/src/licensedcode/additional_license_location_provider.py
@@ -77,7 +77,6 @@ class AdditionalLicensePluginManager(object):
         self.manager = PluggyPluginManager(project_name=project_name)
         self.entrypoint = entrypoint
         self.plugin_base_class = plugin_base_class
-        self.manager.add_hookspecs(sys.modules[project_name])
 
         # set to True once this manager is initialized by running its setup()
         self.initialized = False
-- 
